# Which model provider to use: gemini (default) or claude
LLM_PROVIDER=gemini

# Google AI Studio — has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model (free tier covers Flash, not Pro)
# GEMINI_MODEL=gemini-3.6-flash

# Only needed when LLM_PROVIDER=claude — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# 사용량 카드에 표시할 무료 티어 하루 요청 한도.
# 모델·계정·지역마다 달라서 https://aistudio.google.com/rate-limit 에서 직접 확인하세요.
# 안 넣으면 막대를 안 그립니다 (모르는 한도를 지어내지 않습니다).
# 참고: gemini-3.5-flash-lite 는 2026-08 기준 분당 15회 / 하루 500회였습니다.
# FREE_TIER_DAILY_REQUESTS=500

# 자동 백업 경로. 세션이 저장될 때마다 여기로 스냅샷을 뜹니다.
# 비워두면 백업을 안 합니다. iCloud Drive 예시 (사용자명만 바꾸세요):
# YAP_BACKUP=/Users/사용자명/Library/Mobile Documents/com~apple~CloudDocs/yap-backup.db

# DB 파일 위치 (기본값: data/yap.db)
# YAP_DB=

# 영어 변종: anz (기본, 호주·뉴질랜드 공통) / nz / au / us
# 두 줄을 같은 값으로 맞추세요. 아래 줄은 쉐도잉 음성 선택에 쓰입니다.
ENGLISH_VARIANT=anz
NEXT_PUBLIC_ENGLISH_VARIANT=anz
