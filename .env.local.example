# Which model provider to use: gemini (default) or claude
LLM_PROVIDER=gemini

# Google AI Studio — has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model (free tier covers Flash, not Pro)
# GEMINI_MODEL=gemini-3.6-flash

# Only needed when LLM_PROVIDER=claude — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# 영어 변종: both (기본, 호주·뉴질랜드 공통) / nz / au
ENGLISH_VARIANT=both
NEXT_PUBLIC_ENGLISH_VARIANT=both
